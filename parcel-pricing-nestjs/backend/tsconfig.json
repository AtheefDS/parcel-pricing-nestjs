//tsconfig.json is the configuration file for the TypeScript compiler
{
    "compilerOptions": {
      // TypeScript compiler settings
      //We need to tell TypeScript which JavaScript module system to use when generating JavaScript.
    "module": "commonjs",
    //We need to tell TypeScript which JavaScript version to generate
    "target": "ES2021",
    //These files contain type information about your code.
    "declaration": false,
    //Sometimes we write comments to explain our code.
    "removeComments": true,
    //NestJS uses decorators and metadata to understand classes and their dependencies
    "emitDecoratorMetadata": true,
    //NestJS uses decorators extensively.
    "experimentalDecorators": true,
    //Sometimes JavaScript libraries do not provide a default export, but TypeScript allows you to write
    //  a default import from them with this option.
    "allowSyntheticDefaultImports": true,
    //It improves compatibility between CommonJS modules and ES Module-style imports.
    "esModuleInterop": true,
    //When an error happens in generated JavaScript, we want to identify the original TypeScript source code.
    "sourceMap": true,
    //We need to tell TypeScript where to save the generated JavaScript files
    "outDir": "./dist",
    //We need to tell TypeScript where our original source code is located
    "rootDir": "./src",
    //We want TypeScript to save information about previous compilations.
  //When we compile again, TypeScript can reuse this information instead of checking everything from scratch.
  //This can improve compilation speed.
    "incremental": true,
    //Our application uses external libraries.
    "skipLibCheck": true,
    //We want TypeScript to check our code carefully and identify possible mistakes.
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"]
}
