//tsconfig.json is the configuration file for the TypeScript compiler
{
    "compilerOptions": {
      // TypeScript compiler settings
      //We need to tell TypeScript which JavaScript module system to use when generating JavaScript.
    "module": "commonjs",
    //We need to tell TypeScript which JavaScript version to generate
    "target": "ES2021",
    //These files contain type information about your code.
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*"]
}
